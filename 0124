<!DOCTYPE html>
<html lang="zh-HK">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>每日打氣站 🍕🦊</title>
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
  <style>
    :root {
      --bg-color: #fdfbf7;
      --card-bg: #ffffff;
      --primary: #ff8c42;
      --text-main: #4a3e3d;
      --text-sub: #8c7b75;
      --border-color: #f0e6df;
    }

    body {
      margin: 0;
      padding: 0;
      background-color: var(--bg-color);
      color: var(--text-main);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      display: flex;
      flex-direction: column;
      align-items: center;
      min-height: 100vh;
    }

    header {
      text-align: center;
      padding: 40px 20px 10px;
    }

    h1 {
      margin: 0;
      font-size: 1.8rem;
      color: var(--primary);
    }

    .subtitle {
      font-size: 0.95rem;
      color: var(--text-sub);
      margin-top: 8px;
    }

    .main-card {
      background: var(--card-bg);
      border: 2px solid var(--border-color);
      border-radius: 20px;
      padding: 30px 20px;
      margin: 20px;
      width: 85%;
      max-width: 400px;
      text-align: center;
      box-shadow: 0 8px 20px rgba(0,0,0,0.04);
    }

    .btn-open {
      background: var(--primary);
      color: white;
      border: none;
      padding: 14px 28px;
      font-size: 1.1rem;
      font-weight: bold;
      border-radius: 50px;
      cursor: pointer;
      box-shadow: 0 4px 12px rgba(255, 140, 66, 0.3);
      transition: transform 0.2s, background 0.2s;
    }

    .btn-open:active {
      transform: scale(0.96);
    }

    .modal-overlay {
      display: none;
      position: fixed;
      top: 0; left: 0; width: 100%; height: 100%;
      background: rgba(0,0,0,0.5);
      justify-content: center;
      align-items: center;
      z-index: 100;
    }

    .modal-content {
      background: white;
      padding: 30px 24px;
      border-radius: 24px;
      width: 85%;
      max-width: 380px;
      text-align: center;
      position: relative;
      animation: popIn 0.3s ease-out;
    }

    @keyframes popIn {
      from { transform: scale(0.8); opacity: 0; }
      to { transform: scale(1); opacity: 1; }
    }

    .modal-title {
      font-size: 1.3rem;
      font-weight: bold;
      color: var(--primary);
      margin-bottom: 12px;
    }

    .modal-body {
      font-size: 1.05rem;
      line-height: 1.6;
      color: var(--text-main);
      white-space: pre-line;
      margin-bottom: 24px;
    }

    .btn-close {
      background: #f0f0f0;
      color: #666;
      border: none;
      padding: 10px 24px;
      border-radius: 20px;
      font-weight: bold;
      cursor: pointer;
    }
  </style>
</head>
<body>

  <header>
    <h1>每日打氣站 🍕🦊</h1>
    <div class="subtitle">365 天陪伴你的暖心小卡</div>
  </header>

  <div class="main-card">
    <p style="font-size: 1.1rem; margin-bottom: 20px;">今日係 <b id="today-date">--</b></p>
    <button class="btn-open" onclick="openTodayCard()">拆開今日打氣心語 💌</button>
  </div>

  <div class="modal-overlay" id="cardModal">
    <div class="modal-content">
      <div class="modal-title" id="mTitle">標題</div>
      <div class="modal-body" id="mContent">內容</div>
      <button class="btn-close" onclick="closeModal()">收到！❤️</button>
    </div>
  </div>

  <script>
    const messages = {
      1: { title: "teaser26歲生日快樂！今日你係大佬😼", content: "瓜瓜26歲了，好開心可以同你度過4年嘅生日。前兩年都係回顧，今年我希望可以同你展望未來。新一年，pizza同每日打氣站會同你一齊度過！🍕❤️🦊" },
      2: { title: "今日都會很好的！🤩", content: "係唔係好期待每日開打氣小卡呢～\n\n雖然過完生日，但個勢會keep住好的！好日子壞日子，都有打氣小卡陪你，每日有驚喜🎉" },
      14: { title: "新年行大運🤑", content: "新年快樂！又到年初一，係時候逗好多好多利是😆🧧" },
      60: { title: "🇹🇼 TW x JP 🇯🇵 之旅啟程✈️", content: "今晚就飛台北啦！上一次已經係23年嘅事，仲要係為咗結婚，但明明唔可以，笑死。好期待好期待，祝我哋旅程愉快！❤️" },
      61: { title: "Pizza der Birthday☺️", content: "好開心好開心，第一次出國慶生，仲要喺日本！多謝瓜瓜plan咗呢個trip❤️今日都要玩得盡興！！" }
    };

    const startDate = new Date("2027-01-24");
    const today = new Date();
    document.getElementById("today-date").innerText = today.toLocaleDateString();

    function getDayIndex() {
      const diffTime = today - startDate;
      const diffDays = Math.floor(diffTime / (1000 * 60 * 60 * 24)) + 1;
      return diffDays > 0 ? diffDays : 1;
    }

    function triggerConfetti() {
      const scalar = 2.5;
      const pizza = confetti.shapeFromText({ text: '🍕', scalar });
      const fox = confetti.shapeFromText({ text: '🦊', scalar });
      const cake = confetti.shapeFromText({ text: '🎂', scalar });
      const heart = confetti.shapeFromText({ text: '❤️', scalar });

      confetti({
        particleCount: 30,
        spread: 100,
        origin: { y: 0.5 },
        shapes: [pizza, fox, cake, heart],
        scalar: 2,
        ticks: 250,
        gravity: 0.4,
        drift: 0
      });
    }

    function openTodayCard() {
      const day = getDayIndex();
      const data = messages[day] || { title: `Day ${day} 打氣小卡`, content: "今日也要加油喔！永遠支持你！💪❤️" };
      document.getElementById("mTitle").innerText = data.title;
      document.getElementById("mContent").innerText = data.content;
      document.getElementById("cardModal").style.display = "flex";
      triggerConfetti();
    }

    function closeModal() {
      document.getElementById("cardModal").style.display = "none";
    }
  </script>
</body>
</html>
</html>
<!DOCTYPE html>
<html lang="zh-HK">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>365日每日運勢 🎂 生日快樂！</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Zen Maru Gothic (可愛圓體) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@500;700;900&display=swap" rel="stylesheet">
    <!-- Font Awesome 圖標 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Canvas Confetti 慶祝特效 -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        cream: '#FFF9F0',
                        warmPink: '#FFB7B2',
                        pastelYellow: '#FFE5B4',
                        softOrange: '#FFDAC1',
                        accentPink: '#FF8B94',
                    },
                    fontFamily: {
                        cute: ['Zen Maru Gothic', 'sans-serif'],
                    },
                    animation: {
                        'bounce-slow': 'bounce 2s infinite',
                        'float': 'float 3s ease-in-out infinite',
                        'pulse-gentle': 'pulseGentle 2s cubic-bezier(0.4, 0, 0.6, 1) infinite',
                    },
                    keyframes: {
                        float: {
                            '0%, 100%': { transform: 'translateY(0px)' },
                            '50%': { transform: 'translateY(-10px)' },
                        },
                        pulseGentle: {
                            '0%, 100%': { opacity: 1, transform: 'scale(1)' },
                            '50%': { opacity: 0.9, transform: 'scale(1.02)' },
                        }
                    }
                }
            }
        }
    </script>

    <style>
        body {
            font-family: 'Zen Maru Gothic', sans-serif;
            background-color: #FFF9F0;
            background-image: radial-gradient(#FFDAC1 1px, transparent 1px);
            background-size: 20px 20px;
        }

        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

        .btn-cute {
            transition: all 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            box-shadow: 0px 6px 0px #FFB7B2;
        }
        .btn-cute:active {
            transform: translateY(4px);
            box-shadow: 0px 2px 0px #FFB7B2;
        }

        .heart-particle {
            position: fixed;
            pointer-events: none;
            z-index: 0;
            animation: floatUp 6s linear infinite;
            opacity: 0.6;
        }

        @keyframes floatUp {
            0% { transform: translateY(100vh) rotate(0deg); opacity: 0.8; }
            100% { transform: translateY(-10vh) rotate(360deg); opacity: 0; }
        }

        /* Flip card effect */
        .card-flip-inner {
            transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
            transform-style: preserve-3d;
        }
        .card-flipped {
            transform: rotateY(180deg);
        }
    </style>
</head>
<body class="min-h-screen text-gray-700 flex flex-col justify-between relative overflow-x-hidden pb-12">

    <!-- 背景漂浮粒子 -->
    <div id="particles-container" class="fixed inset-0 pointer-events-none z-0"></div>

    <!-- 🧪 頂部預覽 / 測試模式控制列 -->
    <div class="bg-amber-100 border-b-2 border-amber-300 px-4 py-2 text-xs text-amber-900 flex flex-wrap items-center justify-between gap-2 relative z-20 shadow-sm">
        <div class="flex items-center gap-2">
            <span class="bg-amber-500 text-white font-bold px-2 py-0.5 rounded-md text-[10px] animate-pulse">測試工具</span>
            <span class="font-bold">🧪 網頁預覽測試模式：</span>
            <span class="text-amber-700 hidden sm:inline">（切換以提前測試卡片解鎖與翻牌效果）</span>
        </div>
        <div class="flex items-center gap-3">
            <label class="inline-flex items-center cursor-pointer">
                <input type="checkbox" id="test-mode-toggle" onchange="toggleTestMode()" class="sr-only peer">
                <div class="relative w-11 h-6 bg-gray-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-accentPink"></div>
                <span class="ms-2 font-bold text-xs" id="test-mode-status">解鎖所有日期 (OFF)</span>
            </label>
            <button onclick="previewDayCard(1)" class="bg-accentPink hover:bg-red-400 text-white font-bold px-3 py-1 rounded-xl shadow-xs text-xs flex items-center gap-1 transition">
                <i class="fa-solid fa-wand-magic-sparkles"></i> 試玩：開箱睇 Day 1 運勢
            </button>
        </div>
    </div>

    <!-- 頂部導覽列 -->
    <header class="relative z-10 w-full max-w-4xl mx-auto pt-6 px-4 text-center">
        <div class="bg-white/80 backdrop-blur-md rounded-3xl p-4 sm:p-6 shadow-lg border-4 border-pastelYellow flex flex-col sm:flex-row items-center justify-between gap-4">
            
            <!-- 【公仔位 1：Header 大頭照】 -->
            <div class="relative group cursor-pointer" onclick="previewDayCard(1)" title="點擊預覽">
                <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-full bg-pastelYellow border-4 border-white shadow-md flex items-center justify-center overflow-hidden animate-float">
                    <img id="header-avatar" src="https://api.dicebear.com/7.x/bottts-neutral/svg?seed=BirthdayBear&backgroundColor=ffe5b4" alt="生日吉祥物" class="w-full h-full object-cover">
                </div>
                <span class="absolute -bottom-2 -right-1 bg-accentPink text-white text-xs font-bold px-2 py-0.5 rounded-full shadow">Day <span id="current-day-badge">1</span></span>
            </div>

            <div class="text-center sm:text-left flex-1">
                <div class="inline-block bg-pastelYellow text-amber-800 text-xs font-bold px-3 py-1 rounded-full mb-1">
                    🎂 生日驚喜限定 · 365日籤筒 (2027-2028)
                </div>
                <h1 class="text-2xl sm:text-3xl font-black text-gray-800 tracking-wide">
                    每日幸運抽籤簿 ✨
                </h1>
                <p class="text-xs sm:text-sm text-gray-500 mt-1">
                    由 2027年1月24號 起，每日為你解鎖專屬嘅運勢同祝福！
                </p>
            </div>

            <!-- 計時器 -->
            <div class="bg-cream rounded-2xl p-3 border-2 border-softOrange text-center min-w-[140px]">
                <div class="text-[10px] text-gray-400 font-bold uppercase tracking-wider" id="countdown-label">距離聽日解鎖仲有</div>
                <div id="countdown-timer" class="text-base font-black text-accentPink font-mono mt-0.5">00:00:00</div>
            </div>
        </div>
    </header>

    <!-- 主要內容區 -->
    <main class="relative z-10 w-full max-w-4xl mx-auto px-4 mt-6 flex-1 flex flex-col gap-8">

        <!-- 今日運勢主卡片 -->
        <section id="today-section" class="w-full">
            <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-xl border-4 border-warmPink relative overflow-hidden transition-all duration-300">
                <div class="absolute -right-12 top-6 bg-accentPink text-white font-black text-xs px-12 py-1.5 rotate-45 shadow-sm">
                    TODAY ✨
                </div>

                <div class="flex flex-col md:flex-row items-center gap-6">
                    <!-- 【公仔位 2：今日主圖】 -->
                    <div class="w-36 h-36 sm:w-44 sm:h-44 flex-shrink-0 bg-cream rounded-2xl border-4 border-pastelYellow p-2 shadow-inner flex flex-col items-center justify-center relative">
                        <img id="today-mascot" src="https://api.dicebear.com/7.x/bottts-neutral/svg?seed=BirthdayBear&backgroundColor=ffe5b4" alt="當日吉祥物" class="w-full h-full object-contain animate-bounce-slow">
                        <div class="absolute bottom-1 bg-white/90 px-2 py-0.5 rounded-full text-[10px] text-gray-500 font-bold shadow-xs">
                            今日主角
                        </div>
                    </div>

                    <!-- 內容區 -->
                    <div class="flex-1 text-center md:text-left w-full">
                        <div class="flex flex-wrap items-center justify-center md:justify-start gap-2 mb-2">
                            <span id="today-day-number" class="bg-warmPink text-white font-bold text-xs px-2.5 py-1 rounded-lg">Day --</span>
                            <span id="today-date-str" class="text-xs text-gray-400 font-medium">--月--日</span>
                        </div>

                        <h2 id="today-title" class="text-xl sm:text-2xl font-black text-gray-800 mb-2">
                            點擊下面按鈕拆開今日運勢！
                        </h2>

                        <!-- 翻牌前 (未解鎖) -->
                        <div id="locked-today-view" class="py-2 flex flex-col items-center md:items-start">
                            <p id="locked-today-desc" class="text-gray-500 text-sm mb-4">聽日嘅運勢仲未知，但今日嘅幸運已經為你準備好啦！</p>
                            
                            <div class="flex flex-wrap items-center justify-center md:justify-start gap-3">
                                <button id="unlock-today-btn" onclick="revealTodayFortune()" class="btn-cute bg-accentPink hover:bg-red-400 text-white font-black text-base px-8 py-3 rounded-2xl flex items-center gap-2 cursor-pointer">
                                    <i class="fa-solid fa-gift text-lg"></i> 解鎖今日運勢
                                </button>
                                
                                <button onclick="previewDayCard(1)" class="bg-amber-400 hover:bg-amber-500 text-amber-950 font-bold text-sm px-5 py-3 rounded-2xl flex items-center gap-2 cursor-pointer shadow-sm transition">
                                    <i class="fa-solid fa-eye"></i> 預覽 Day 1 效果
                                </button>
                            </div>
                        </div>

                        <!-- 翻牌後 (已解鎖) -->
                        <div id="unlocked-today-view" class="hidden space-y-4">
                            <div class="flex flex-wrap items-center justify-center md:justify-start gap-4 bg-cream p-3 rounded-2xl border border-softOrange text-xs font-bold text-gray-600">
                                <div>幸運指數：<span id="today-stars" class="text-amber-400 text-sm">★★★★★</span></div>
                                <div>幸運色：<span id="today-color" class="text-accentPink">---</span></div>
                                <div>幸運小物：<span id="today-item" class="text-amber-600">---</span></div>
                            </div>

                            <div class="bg-cream p-4 rounded-2xl border-2 border-dashed border-warmPink text-gray-700 text-sm sm:text-base leading-relaxed" id="today-content">
                                運勢內容載入中...
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 365天日曆網格 -->
        <section class="w-full">
            <div class="bg-white/90 backdrop-blur-md rounded-3xl p-6 shadow-lg border-4 border-pastelYellow">
                <div class="flex flex-col sm:flex-row items-center justify-between gap-3 mb-6">
                    <div>
                        <h3 class="text-xl font-black text-gray-800 flex items-center gap-2">
                            <i class="fa-solid fa-calendar-days text-accentPink"></i> 365日運勢日曆
                        </h3>
                        <p class="text-xs text-gray-400 mt-0.5">點擊任何一天即可預覽或回顧運勢內容喔！</p>
                    </div>
                    
                    <div class="bg-cream px-3 py-1.5 rounded-xl border border-softOrange text-xs font-bold text-gray-600">
                        解鎖進度：<span id="unlocked-count" class="text-accentPink font-black">0</span> / 365 日
                    </div>
                </div>

                <!-- 月份分頁 -->
                <div class="flex items-center gap-2 mb-4 overflow-x-auto pb-2 no-scrollbar" id="month-tabs"></div>

                <!-- 日曆 Grid -->
                <div id="calendar-grid" class="grid grid-cols-4 sm:grid-cols-6 md:grid-cols-8 gap-2.5 max-h-[450px] overflow-y-auto p-1 rounded-2xl"></div>
            </div>
        </section>

    </main>

    <!-- 頁尾 -->
    <footer class="relative z-10 w-full max-w-4xl mx-auto mt-8 px-4 text-center text-xs text-gray-400">
        <p>Made with ❤️ for Your Birthday | 每日一份小驚喜 ✨</p>
    </footer>

    <!-- Modal 彈窗 (運勢卡片解鎖) -->
    <div id="fortune-modal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4 hidden">
        <div class="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl border-4 border-pastelYellow relative transition-all" id="modal-container">
            
            <button onclick="closeModal()" class="absolute top-4 right-4 w-8 h-8 bg-cream hover:bg-softOrange rounded-full flex items-center justify-center text-gray-500 font-bold text-lg z-20">
                ✕
            </button>

            <!-- 【公仔位 3：Modal 彈窗圖】 -->
            <div class="w-28 h-28 mx-auto -mt-12 bg-pastelYellow border-4 border-white rounded-full p-1 shadow-lg flex items-center justify-center overflow-hidden relative z-10">
                <img id="modal-mascot" src="https://api.dicebear.com/7.x/bottts-neutral/svg?seed=HappyBear&backgroundColor=ffe5b4" alt="Modal Mascot" class="w-full h-full object-cover">
            </div>

            <div class="text-center mt-3">
                <div id="modal-badge" class="inline-block bg-warmPink text-white text-xs font-bold px-3 py-0.5 rounded-full mb-2">
                    Day 1 · 1月24日
                </div>
                <h3 id="modal-title" class="text-xl font-black text-gray-800 mb-2">
                    標題
                </h3>

                <!-- 未來鎖定提示 -->
                <div id="modal-locked-body" class="hidden space-y-3 my-4">
                    <p class="text-gray-600 text-sm font-medium leading-relaxed bg-cream p-4 rounded-2xl border border-softOrange">
                        🔒 未來仲未到，留返啲驚喜畀聽日啦！<br>
                        好酒沉樽底，記得聽日再嚟開箱喔 ✨
                    </p>
                    <div class="flex gap-2">
                        <button onclick="closeModal()" class="btn-cute flex-1 bg-gray-200 text-gray-700 font-bold py-2.5 rounded-xl">
                            知道了
                        </button>
                        <button onclick="forceUnlockCurrentModal()" class="bg-amber-400 hover:bg-amber-500 text-amber-950 font-bold py-2.5 px-4 rounded-xl text-xs flex items-center justify-center gap-1">
                            🧪 測試：強制開箱
                        </button>
                    </div>
                </div>

                <!-- 已解鎖內容 -->
                <div id="modal-unlocked-body" class="hidden space-y-4 my-3 text-left">
                    <div class="flex justify-around bg-cream p-2.5 rounded-xl border border-softOrange text-xs font-bold text-gray-600 text-center">
                        <div>幸運指數<br><span id="modal-stars" class="text-amber-400 text-sm">★★★★★</span></div>
                        <div>幸運色<br><span id="modal-color" class="text-accentPink">草莓粉</span></div>
                        <div>幸運小物<br><span id="modal-item" class="text-amber-600">蛋糕</span></div>
                    </div>

                    <div id="modal-content" class="bg-cream/60 p-4 rounded-2xl border border-dashed border-warmPink text-gray-700 text-sm leading-relaxed max-h-56 overflow-y-auto">
                        運勢內容...
                    </div>

                    <button onclick="triggerConfetti()" class="w-full bg-pastelYellow hover:bg-amber-200 text-amber-900 font-bold py-2 rounded-xl text-xs flex items-center justify-center gap-1 transition">
                        🎉 再放一次彩帶慶祝！
                    </button>
                </div>
            </div>
        </div>
    </div>


    <script>
        /* =========================================================================
           1. 🎨 手繪公仔圖片設定 (可換成你上傳的圖床連結)
           =========================================================================
        */
        const CUSTOM_MASCOTS = {
            header: "https://api.dicebear.com/7.x/bottts-neutral/svg?seed=BirthdayBear&backgroundColor=ffe5b4",
            happy: "https://api.dicebear.com/7.x/bottts-neutral/svg?seed=HappyBear&backgroundColor=ffe5b4",
            locked: "https://api.dicebear.com/7.x/bottts-neutral/svg?seed=LockedMascot&backgroundColor=ffe5b4"
        };


        /* =========================================================================
           2. 📜 365日運勢資料庫
           =========================================================================
        */
        const fortuneDatabase = [
            {
                day: 1,
                title: "生日快樂！🎉 今日嘅你最閃耀！",
                stars: "★★★★★",
                color: "草莓粉 🍓",
                item: "手作蛋糕 🎂",
                content: "第一天！祝你生日快樂～希望呢個 365 日每日運勢日曆可以陪住你度過開開心心嘅一年！今日最適合食件好食嘅蛋糕，許個願望！"
            },
            {
                day: 2,
                title: "元氣滿滿嘅第二天 ⚡",
                stars: "★★★★☆",
                color: "奶油黃 💛",
                item: "熱牛奶 🥛",
                content: "今日係開朗爆棚嘅一天！遇到任何難題都可以順利解決，記得飲多啲水～加油！"
            },
            {
                day: 3,
                title: "幸運小驚喜降臨 🍀",
                stars: "★★★★★",
                color: "薄荷綠 🌿",
                item: "幸運金幣 🪙",
                content: "今日可能會有意想不到嘅小驚喜發生喔！保持微笑，幸運神會一直黐住你～"
            }
        ];

        // 自動補全 365 天範例資料
        const defaultColors = ["檸檬黃 💛", "水鸭藍 🌊", "薰衣草紫 💜", "蜜桃粉 🍑", "抹茶綠 🍵", "天空藍 ☁️", "珊瑚橘 🍊"];
        const defaultItems = ["幸運御守 ⛩️", "雪糕 🍦", "舒服的軟枕 ☁️", "可愛貼紙 🎨", "耳機 🎧", "熱咖啡 ☕"];

        for (let i = 4; i <= 365; i++) {
            fortuneDatabase.push({
                day: i,
                title: `✨ Day ${i} 幸運指南`,
                stars: i % 5 === 0 ? "★★★★★" : "★★★★☆",
                color: defaultColors[i % defaultColors.length],
                item: defaultItems[i % defaultItems.length],
                content: `（寫給他的第 ${i} 天專屬運勢... 可以喺代碼嘅 fortuneDatabase 入面隨時修改成你想同佢講嘅廣東話貼士或回憶小故事喔！❤️）`
            });
        }


        /* =========================================================================
           3. 🗓️ 日期與測試模式控制
           =========================================================================
        */
        const START_DATE = new Date(2027, 0, 24); // 2027年1月24日
        let isTestMode = false;
        let activeModalDay = 1;

        function getCurrentDayNumber() {
            if (isTestMode) return 365; // 測試模式下自動允許解鎖所有天數

            const now = new Date();
            const todayZero = new Date(now.getFullYear(), now.getMonth(), now.getDate());
            const startZero = new Date(START_DATE.getFullYear(), START_DATE.getMonth(), START_DATE.getDate());

            if (todayZero < startZero) return 0; // 0 代表未到2027年1月24日

            const diffTime = todayZero - startZero;
            const diffDays = Math.floor(diffTime / (1000 * 60 * 60 * 24)) + 1;
            return Math.min(diffDays, 365);
        }

        function toggleTestMode() {
            isTestMode = document.getElementById('test-mode-toggle').checked;
            document.getElementById('test-mode-status').innerText = isTestMode ? "已解鎖所有日期 (ON)" : "實時日期鎖定 (OFF)";
            document.getElementById('test-mode-status').className = isTestMode ? "ms-2 font-bold text-xs text-accentPink" : "ms-2 font-bold text-xs";
            
            initApp();
        }


        /* =========================================================================
           4. ⏱️ 倒計時器
           =========================================================================
        */
        function updateCountdown() {
            const now = new Date();
            const todayDay = getCurrentDayNumber();
            let targetDate = (todayDay === 0 && !isTestMode) ? START_DATE : new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1, 0, 0, 0);
            const diff = targetDate - now;

            if (diff <= 0 && !isTestMode) { location.reload(); return; }

            const days = Math.floor(diff / (1000 * 60 * 60 * 24));
            const hours = Math.floor((diff / (1000 * 60 * 60)) % 24).toString().padStart(2, '0');
            const minutes = Math.floor((diff / (1000 * 60)) % 60).toString().padStart(2, '0');
            const seconds = Math.floor((diff / 1000) % 60).toString().padStart(2, '0');

            document.getElementById('countdown-label').innerText = (todayDay === 0 && !isTestMode) ? "距離生日正式開始" : "距離聽日解鎖仲有";
            document.getElementById('countdown-timer').innerText = (todayDay === 0 && days > 0 && !isTestMode) ? `${days}日 ${hours}:${minutes}:${seconds}` : `${hours}:${minutes}:${seconds}`;
        }
        setInterval(updateCountdown, 1000);


        /* =========================================================================
           5. 🎨 應用程式渲染 logic
           =========================================================================
        */
        let currentFilterMonth = 'ALL';

        function initApp() {
            const todayDay = getCurrentDayNumber();

            // 計算 365 天日期標籤
            fortuneDatabase.forEach((item, index) => {
                const dateObj = new Date(2027, 0, 24);
                dateObj.setDate(dateObj.getDate() + index);
                item.dateStr = `${dateObj.getMonth() + 1}月${dateObj.getDate()}日`;
            });

            document.getElementById('current-day-badge').innerText = isTestMode ? '測試中' : (todayDay > 0 ? todayDay : '未開始');
            document.getElementById('header-avatar').src = CUSTOM_MASCOTS.header;

            if (todayDay === 0 && !isTestMode) {
                document.getElementById('today-day-number').innerText = `Day 1 (未到期)`;
                document.getElementById('today-date-str').innerText = "2027年1月24日";
                document.getElementById('today-title').innerText = "🎂 倒數迎接 2027 年生日禮物！";
                document.getElementById('locked-today-desc').innerText = "生日仲未到喔！禮物會喺 2027年1月24日 正式解鎖！";
                document.getElementById('unlocked-count').innerText = 0;
            } else {
                const activeDay = todayDay === 0 ? 1 : todayDay;
                const todayData = fortuneDatabase.find(d => d.day === activeDay) || fortuneDatabase[0];
                document.getElementById('today-day-number').innerText = `Day ${todayData.day}`;
                document.getElementById('today-date-str').innerText = todayData.dateStr;

                if (localStorage.getItem(`unlocked_day_${todayData.day}`) === 'true' || isTestMode) {
                    showTodayUnlockedState(todayData);
                }
                document.getElementById('unlocked-count').innerText = isTestMode ? 365 : todayDay;
            }

            renderMonthTabs();
            renderCalendarGrid();
            createHeartParticles();
            updateCountdown();
        }

        function revealTodayFortune() {
            const todayDay = getCurrentDayNumber();
            const activeDay = todayDay === 0 ? 1 : todayDay;
            const todayData = fortuneDatabase.find(d => d.day === activeDay) || fortuneDatabase[0];
            
            localStorage.setItem(`unlocked_day_${activeDay}`, 'true');
            showTodayUnlockedState(todayData);
            triggerConfetti();
        }

        function showTodayUnlockedState(data) {
            document.getElementById('locked-today-view').classList.add('hidden');
            document.getElementById('unlocked-today-view').classList.remove('hidden');

            document.getElementById('today-title').innerText = data.title;
            document.getElementById('today-stars').innerText = data.stars;
            document.getElementById('today-color').innerText = data.color;
            document.getElementById('today-item').innerText = data.item;
            document.getElementById('today-content').innerText = data.content;
            document.getElementById('today-mascot').src = CUSTOM_MASCOTS.happy;
        }

        function renderMonthTabs() {
            const container = document.getElementById('month-tabs');
            container.innerHTML = '';

            const ranges = [
                { name: '全部 365 日', key: 'ALL' },
                { name: '第1-30日', key: 'R1' },
                { name: '第31-60日', key: 'R2' },
                { name: '第61-90日', key: 'R3' },
                { name: '第91-180日', key: 'R4' },
                { name: '第181-270日', key: 'R5' },
                { name: '第271-365日', key: 'R6' }
            ];

            ranges.forEach(r => {
                const btn = document.createElement('button');
                btn.className = `px-3 py-1 rounded-xl text-xs font-bold whitespace-nowrap transition ${currentFilterMonth === r.key ? 'bg-accentPink text-white' : 'bg-cream text-gray-600 hover:bg-pastelYellow'}`;
                btn.innerText = r.name;
                btn.onclick = () => { currentFilterMonth = r.key; renderMonthTabs(); renderCalendarGrid(); };
                container.appendChild(btn);
            });
        }

        function renderCalendarGrid() {
            const grid = document.getElementById('calendar-grid');
            grid.innerHTML = '';
            const todayDay = getCurrentDayNumber();

            let list = fortuneDatabase;
            if (currentFilterMonth === 'R1') list = list.filter(d => d.day >= 1 && d.day <= 30);
            else if (currentFilterMonth === 'R2') list = list.filter(d => d.day >= 31 && d.day <= 60);
            else if (currentFilterMonth === 'R3') list = list.filter(d => d.day >= 61 && d.day <= 90);
            else if (currentFilterMonth === 'R4') list = list.filter(d => d.day >= 91 && d.day <= 180);
            else if (currentFilterMonth === 'R5') list = list.filter(d => d.day >= 181 && d.day <= 270);
            else if (currentFilterMonth === 'R6') list = list.filter(d => d.day >= 271 && d.day <= 365);

            list.forEach(item => {
                const isUnlocked = isTestMode || (todayDay > 0 && item.day <= todayDay);
                const isToday = item.day === (todayDay === 0 ? 1 : todayDay);

                const card = document.createElement('div');
                let bgStyle = "bg-cream border-gray-200 text-gray-400 opacity-75";
                if (isUnlocked) bgStyle = "bg-white border-warmPink text-gray-700 hover:bg-pastelYellow cursor-pointer shadow-sm";
                if (isToday) bgStyle = "bg-pastelYellow border-accentPink text-gray-800 font-bold ring-2 ring-accentPink cursor-pointer shadow-md";

                card.className = `p-2.5 rounded-2xl border-2 flex flex-col items-center justify-between text-center transition transform active:scale-95 ${bgStyle}`;
                card.onclick = () => openModal(item.day);

                card.innerHTML = `
                    <div class="text-[10px] text-gray-400 font-bold mb-1">${item.dateStr}</div>
                    <div class="my-1">
                        ${isUnlocked 
                            ? `<i class="fa-solid ${isToday ? 'fa-star text-amber-400 text-lg' : 'fa-envelope-open-text text-accentPink text-base'}"></i>` 
                            : `<i class="fa-solid fa-lock text-gray-300 text-base"></i>`
                        }
                    </div>
                    <div class="text-xs font-black mt-1">D-${item.day}</div>
                `;
                grid.appendChild(card);
            });
        }

        function openModal(day) {
            activeModalDay = day;
            const data = fortuneDatabase.find(d => d.day === day);
            if (!data) return;

            const modal = document.getElementById('fortune-modal');
            const todayDay = getCurrentDayNumber();
            const isUnlocked = isTestMode || (todayDay > 0 && day <= todayDay);

            document.getElementById('modal-badge').innerText = `Day ${data.day} · ${data.dateStr}`;
            
            if (isUnlocked) {
                renderModalUnlockedContent(data);
                triggerConfetti();
            } else {
                document.getElementById('modal-mascot').src = CUSTOM_MASCOTS.locked;
                document.getElementById('modal-title').innerText = "未完待續...";

                document.getElementById('modal-unlocked-body').classList.add('hidden');
                document.getElementById('modal-locked-body').classList.remove('hidden');
            }

            modal.classList.remove('hidden');
        }

        function renderModalUnlockedContent(data) {
            document.getElementById('modal-mascot').src = CUSTOM_MASCOTS.happy;
            document.getElementById('modal-title').innerText = data.title;
            document.getElementById('modal-stars').innerText = data.stars;
            document.getElementById('modal-color').innerText = data.color;
            document.getElementById('modal-item').innerText = data.item;
            document.getElementById('modal-content').innerText = data.content;

            document.getElementById('modal-unlocked-body').classList.remove('hidden');
            document.getElementById('modal-locked-body').classList.add('hidden');
        }

        function forceUnlockCurrentModal() {
            const data = fortuneDatabase.find(d => d.day === activeModalDay) || fortuneDatabase[0];
            renderModalUnlockedContent(data);
            triggerConfetti();
        }

        function previewDayCard(day) {
            openModal(day);
            forceUnlockCurrentModal();
        }

        function closeModal() {
            document.getElementById('fortune-modal').classList.add('hidden');
        }

        function triggerConfetti() {
            if (typeof confetti === 'function') {
                confetti({
                    particleCount: 60,
                    spread: 70,
                    origin: { y: 0.6 }
                });
            }
        }

        function createHeartParticles() {
            const container = document.getElementById('particles-container');
            container.innerHTML = '';
            const icons = ['❤️', '✨', '🌸', '⭐', '🎈'];
            for (let i = 0; i < 15; i++) {
                const particle = document.createElement('div');
                particle.className = 'heart-particle';
                particle.innerText = icons[Math.floor(Math.random() * icons.length)];
                particle.style.left = `${Math.random() * 100}vw`;
                particle.style.animationDuration = `${4 + Math.random() * 6}s`;
                particle.style.animationDelay = `${Math.random() * 5}s`;
                particle.style.fontSize = `${12 + Math.random() * 16}px`;
                container.appendChild(particle);
            }
        }

        window.onload = initApp;
    </script>
</body>
</html>